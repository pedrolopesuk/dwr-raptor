        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "differentiable": {
          "default": false,
          "title": "Differentiable",
          "type": "boolean"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nominal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal"
        },
        "options": {
          "default": [],
