{
  "$defs": {
    "AnalysisSpec": {
      "additionalProperties": false,
      "description": "A declared differential/sensitivity analysis.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "method": {
          "enum": [
            "delta",
            "relative_delta",
            "sensitivity",
            "uncertainty",
            "optimization"
          ],
          "title": "Method",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "method"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "ConstraintSpec": {
      "additionalProperties": false,
      "description": "A simple box/linear constraint on one parameter.",
      "properties": {
        "op": {
          "enum": [
            "<=",
            "<",
            ">=",
            ">",
            "=="
          ],
          "title": "Op",
          "type": "string"
        },
        "parameter": {
          "title": "Parameter",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "parameter",
        "op",
        "value"
      ],
      "title": "ConstraintSpec",
      "type": "object"
    },
    "ExecutionSpec": {
      "additionalProperties": false,
      "description": "Execution controls for the run engine.\n\n``isolation`` selects the process boundary. ``\"subprocess\"`` (the default)\nruns each model in an isolated child process so ``timeout_s`` is a hard,\nenforced wall-clock limit; ``\"in_process\"`` is the legacy fast path and does\n**not** enforce the timeout. See ``docs/architecture/ADR-0005-*.md``.",
      "properties": {
        "isolation": {
          "default": "subprocess",
          "enum": [
            "in_process",
            "subprocess"
          ],
          "title": "Isolation",
          "type": "string"
        },
        "max_runs": {
          "default": 512,
          "title": "Max Runs",
          "type": "integer"
        },
        "solver": {
          "default": "auto",
          "enum": [
            "auto",
            "explicit",
            "stiff"
          ],
          "title": "Solver",
          "type": "string"
        },
        "timeout_s": {
          "default": 60.0,
          "title": "Timeout S",
          "type": "number"
        },
        "workdir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workdir"
        }
      },
      "title": "ExecutionSpec",
      "type": "object"
    },
    "FactorSpec": {
      "additionalProperties": false,
      "description": "How one parameter is varied.\n\nThree modes, mutually exclusive:\n\n* ``values`` - an explicit list of values (used by grid designs),\n* ``range`` - ``lower``, ``upper`` and ``steps``; endpoints inclusive via\n  ``numpy.linspace`` (used by grid designs), or\n* ``bounds`` - ``lower``/``upper`` only, with no ``steps``. The number of\n  points comes from ``sampling.n_samples``; this is the natural form for\n  random / Latin-hypercube / Sobol designs. Bounds may be omitted, in which\n  case the model parameter's declared bounds are used.",
      "properties": {
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "parameter": {
          "title": "Parameter",
          "type": "string"
        },
        "steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "values": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "parameter"
      ],
      "title": "FactorSpec",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "description": "A reference to a registered model, optionally pinned to a version.",
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "ReportingSpec": {
      "additionalProperties": false,
      "description": "Evidence/report rendering options.",
      "properties": {
        "formats": {
          "default": [
            "json",
            "markdown"
          ],
          "items": {
            "type": "string"
          },
          "title": "Formats",
          "type": "array"
        },
        "template": {
          "default": "default",
          "title": "Template",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "ReportingSpec",
      "type": "object"
    },
    "SamplingSpec": {
      "additionalProperties": false,
      "description": "The sampling design over the declared factors.",
      "properties": {
        "method": {
          "default": "grid",
          "enum": [
            "grid",
            "random",
            "latin_hypercube",
            "sobol"
          ],
          "title": "Method",
          "type": "string"
        },
        "n_samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Samples"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "SamplingSpec",
      "type": "object"
    },
    "VerificationSpec": {
      "additionalProperties": false,
      "description": "Numerical tolerances and the checks the engine must record.",
      "properties": {
        "atol": {
          "default": 1e-10,
          "title": "Atol",
          "type": "number"
        },
        "checks": {
          "default": [
            "schema",
            "units",
            "bounds",
            "denominator_safety",
            "solver_status"
          ],
          "items": {
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "relative_epsilon": {
          "default": 1e-12,
          "title": "Relative Epsilon",
          "type": "number"
        },
        "rtol": {
          "default": 1e-08,
          "title": "Rtol",
          "type": "number"
        }
      },
      "title": "VerificationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A research question plus a deterministic execution plan.",
  "properties": {
    "analyses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnalysisSpec"
      },
      "title": "Analyses",
      "type": "array"
    },
    "baseline": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Baseline",
      "type": "object"
    },
    "constraints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConstraintSpec"
      },
      "title": "Constraints",
      "type": "array"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionSpec"
    },
    "factors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactorSpec"
      },
      "title": "Factors",
      "type": "array"
    },
    "hypothesis": {
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
    },
    "model_ref": {
      "$ref": "#/$defs/ModelRef"
    },
    "name": {
      "default": "",
      "title": "Name",
      "type": "string"
    },
    "outputs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "array"
    },
    "reporting": {
      "$ref": "#/$defs/ReportingSpec"
    },
    "sampling": {
      "$ref": "#/$defs/SamplingSpec"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verification": {
      "$ref": "#/$defs/VerificationSpec"
    }
  },
  "required": [
    "hypothesis",
    "model_ref",
    "baseline"
  ],
  "title": "ExperimentSpec",
  "type": "object"
}
